# ═══════════════════════════════════════════════════════════════
# Docker Compose Environment
# Copy to .env and fill in.
# ═══════════════════════════════════════════════════════════════
# DB_PASSWORD, INTERNAL_API_KEY and AES_SECRET are REQUIRED:
# docker compose refuses to start without them (no insecure defaults).
# ═══════════════════════════════════════════════════════════════

# Database (init-databases.sh creates all stack DBs for this user)
DB_USER=root
# REQUIRED
DB_PASSWORD=

# Shared internal API key for service-to-service authentication.
# Must match across all services. Generate: openssl rand -hex 32
# REQUIRED
INTERNAL_API_KEY=
# Rotation window: while rotating, the retired key stays valid here until
# every caller has switched. See docs/secret-rotation.md. OPTIONAL
#INTERNAL_API_KEY_PREVIOUS=

# AES rotation: next key version. auth-server encrypts NEW data with it and
# re-encrypts stored envelopes via scripts/reencrypt-aes.mjs; when the script
# reports 0 remaining rows, retire AES_SECRET. See docs/secret-rotation.md.
# Generate: openssl rand -hex 32. OPTIONAL
#AES_SECRET_V2=

# Signed webhook deliveries (event-server -> message-server). The SAME value
# goes to both services: message-server registers with it, event-server signs
# every delivery (HMAC-SHA256, 300s replay window). Leave empty to keep the
# legacy internal-key transport. Generate: openssl rand -hex 32
# OPTIONAL (recommended)
WEBHOOK_SECRET=

# Event-server egress policy for subscriber webhook URLs (anti-SSRF):
#   internal  — any host (default; the bus lives in the docker network)
#   public    — block private/loopback/metadata IPs
#   allowlist — only hosts from WEBHOOK_ALLOW_HOSTS (comma-separated)
WEBHOOK_EGRESS_MODE=internal
WEBHOOK_ALLOW_HOSTS=

# Token binding (iss/aud claims). When set, auth-server embeds the claims in
# every JWT and all services with the SAME values enforce them; empty keeps
# the legacy no-claims behavior. Keep identical stack-wide, roll out in one
# deploy. OPTIONAL (recommended)
JWT_ISSUER=
JWT_AUDIENCE=

# Auth server — AES-256 key for encrypting 2FA secrets and OAuth tokens.
# Use hex: openssl rand -hex 32. A legacy non-hex 32-char value still works
# (key version 1 keeps the old lenient parse); rotation to AES_SECRET_V2
# requires a proper hex key. See docs/secret-rotation.md.
# REQUIRED
AES_SECRET=

# Social SSO (optional — login via provider fails until set)
LEADER_CLIENT_ID=
LEADER_CLIENT_SECRET=
UNTI_CLIENT_ID=
UNTI_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (MailHog in dev via docker-compose.override.yml)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Test
SMTP_SENDER_EMAIL=noreply@test.local

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# ═══════════════════════════════════════════════════════════════
# S3 STORAGE PROFILE (docker-compose.s3.yml). REQUIRED when
# starting with: docker compose -f docker-compose.yml \
#   -f docker-compose.s3.yml up -d
# Default backend: SeaweedFS (Apache 2.0). MinIO removed its images from
# Docker Hub (2025-09) and froze OSS — usable only from a private registry.
# Generate keys: openssl rand -hex 16.
# ═══════════════════════════════════════════════════════════════
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prod: client-facing endpoint for presigned URLs (subdomain passthrough
# to minio:9000, see docs/s3-storage.md). Dev default: http://127.0.0.1:9000
#S3_PRESIGN_ENDPOINT=
# Presigned URL lifetime, seconds (default 900)
#S3_PRESIGN_EXPIRES_SEC=900
# Public-bucket/CDN case only: returned URLs point here (bucket read-anonymous)
#S3_PUBLIC_URL=
# Multer ceiling for POST /files/upload, MB (default 50; direct presigned
# PUT path bypasses nginx and is not affected)
#MAX_UPLOAD_SIZE=50


# ═══════════════════════════════════════════════════════════════
# Monitoring (opt-in). Uncomment COMPOSE_PROFILES to start
# prometheus + grafana with `docker compose up -d`.
# Grafana UI: http://localhost:${GRAFANA_PORT} (change the default
# admin password on first login).
# ═══════════════════════════════════════════════════════════════

# COMPOSE_PROFILES=monitoring
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ═══════════════════════════════════════════════════════════════
# TWO-FACTOR AUTH (auth-server master switch; per-account setup via
# POST /account/methods/2fa). Off by default.
# ═══════════════════════════════════════════════════════════════
# TWO_FACTOR_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# AUTH RATE-LIMIT STORAGE: memory (default, single replica) or redis.
# Redis is required when scaling auth-server to 2+ replicas, otherwise
# each replica enforces its own counter set (limits x N).
# ═══════════════════════════════════════════════════════════════
#THROTTLE_STORAGE=memory
#REDIS_URL=redis://redis:6379
# Example: THROTTLE_STORAGE=redis docker compose up -d --scale auth-server=2

# ═══════════════════════════════════════════════════════════════
# JWT SIGNING KEYS: the stack generates a shared RS256 pair once (the
# `auth-keys` init job, stored in the `auth_keys` volume) — multi-replica
# safe. To bring your own keys, mount them and drop the auth-keys job:
#   volumes: [./keys:/keys:ro]   # jwt-private.pem / jwt-public.pem
# Without key files auth falls back to EPHEMERAL per-boot keys: every
# restart invalidates all tokens and replicas reject each other's tokens.
# ROTATION: scripts/rotate-jwt-keys.sh generates a new pair and keeps the
# retired public key in the volume; point this at it for the overlap window
# (old tokens stay valid until they expire), then clean up. Zero-downtime
# procedure: docs/secret-rotation.md. OPTIONAL
#JWT_PREVIOUS_PUBLIC_KEY_PATHS=
# ═══════════════════════════════════════════════════════════════
