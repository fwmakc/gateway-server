# ═══════════════════════════════════════════════════════════════
# Docker Compose Environment
# Copy to .env and customize
# ═══════════════════════════════════════════════════════════════

# Database
DB_USER=root
DB_PASSWORD=1234

# Shared internal API key for service-to-service authentication
# Must match across all services
INTERNAL_API_KEY=changeme

# Auth server
SESSION_SECRET=dev-session-secret
AES_SECRET=change_me_to_32_characters__

# SMTP (MailHog in dev via docker-compose.override.yml)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Test
SMTP_SENDER_EMAIL=noreply@test.local

# Nginx
NGINX_PORT=80

# Schema sync (true for dev, false for production with migrations)
DB_SYNCHRONIZE=false
